# ============================================
# TONTI Backend — variables d'environnement
# Copier en .env (docker compose) ou les définir chez l'hébergeur
# ============================================

SPRING_PROFILES_ACTIVE=prod

# --- Base de données (URL JDBC) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/tonti_db
DATABASE_USERNAME=tonti
DATABASE_PASSWORD=tonti_secret

# --- JWT : openssl rand -base64 64 ---
JWT_SECRET=change-me-with-openssl-rand-base64-64

# --- URLs publiques (redirections de paiement) ---
API_BASE_URL=https://api.tonti.app
WEB_BASE_URL=https://tonti.app
APP_URL_SCHEME=tonti

# --- CORS : web + application iOS (capacitor://localhost) ---
ALLOWED_ORIGINS=https://tonti.app,capacitor://localhost

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Divers ---
API_DOCS_ENABLED=false
AUTH_RATE_LIMIT=10

# Lanes de build et de publication App Store de Tonti.
#
# Authentification par clé API App Store Connect (pas d'identifiant Apple ni de 2FA en CI).
# Variables attendues : voir ios/README.md (section « Secrets CI »).

require "json"

default_platform(:ios)

APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "app.tonti.ios")
PROJECT = "App/App.xcodeproj"
SCHEME = "App"
KEYCHAIN = "fastlane_tmp_keychain"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Construit l'IPA signée pour l'App Store"
  lane :build do
    authenticate
    signing

    version = ENV["APP_VERSION"] || JSON.parse(File.read("../../package.json")).fetch("version")
    build_number = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    ) + 1

    UI.message("Tonti #{version} (#{build_number})")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "Tonti.ipa",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => lane_context[SharedValues::SIGH_NAME] }
      }
    )
  end

  desc "Publie un build sur TestFlight (testeurs internes)"
  lane :beta do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: File.read("metadata/fr-FR/release_notes.txt")
    )
  end

  desc "Envoie le build et les métadonnées sur l'App Store (soumission à la revue optionnelle)"
  lane :release do
    build
    deliver(
      submit_for_review: ENV["SUBMIT_FOR_REVIEW"] == "true",
      automatic_release: false,
      phased_release: true,
      force: true
    )
  end

  desc "Met à jour uniquement les métadonnées App Store (textes, URLs)"
  lane :metadata do
    authenticate
    deliver(skip_binary_upload: true, force: true)
  end

  private_lane :authenticate do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  # Signature manuelle et reproductible : certificat de distribution importé depuis les secrets,
  # profil App Store créé ou récupéré via l'API App Store Connect.
  private_lane :signing do
    if ENV["IOS_DIST_CERT_PATH"]
      import_certificate(
        certificate_path: ENV.fetch("IOS_DIST_CERT_PATH"),
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: KEYCHAIN,
        keychain_password: ""
      )
    end

    get_provisioning_profile(app_identifier: APP_IDENTIFIER)

    update_code_signing_settings(
      path: PROJECT,
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )
  end
end

# ============================================
# TONTI Frontend — variables d'environnement (Vite)
# Copier en .env.local (web) ou .env.mobile.local (build iOS)
# ============================================

# URL de l'API backend
VITE_API_URL=http://localhost:8080/api/v1

# URL publique du site web (liens d'invitation partagés depuis l'app native)
VITE_PUBLIC_WEB_URL=http://localhost:5173

# Base de publication web ('/' par défaut, '/Tonti/' pour GitHub Pages)
VITE_BASE_URL=/

# Mesure d'audience Plausible (web uniquement, optionnel)
VITE_PLAUSIBLE_DOMAIN=
